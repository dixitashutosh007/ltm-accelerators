      "id": "FIN-01",
      "section": "FinOps Data Readiness",
      "prompt": "How ready is the organization to normalize technology cost and usage data across providers and technology categories into a common analytical model?",
      "interaction": "single-select",
      "scopeTrigger": "ANY_FINOPS_SCOPE",
      "scoring": {
        "method": "semantic-option-map",
        "dimensionIds": [
          "COST-01"
        ],
        "defaultMap": {
          "FOCUS_READY": 100,
          "NORMALIZED": 80,
          "PARTIAL": 60,
          "PROVIDER_NATIVE": 35,
          "FRAGMENTED": 15
        }
      },
      "finopsCapabilities": [
        "DATA_INGESTION",
        "REPORTING_ANALYTICS"
      ],
      "principles": [
        "P4"
      ],
      "evidenceImplication": "Validate with evidence before quantifying material opportunity.",
