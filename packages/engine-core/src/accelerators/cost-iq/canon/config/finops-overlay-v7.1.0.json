        {
          "id": "FOCUS_READY",
          "label": "FOCUS-aligned or equivalent normalized model is established and routinely used."
        },
        {
          "id": "NORMALIZED",
          "label": "A common normalized model exists across major providers/categories."
        },
        {
          "id": "PARTIAL",
          "label": "Some linkage exists but material gaps remain."
        },
        {
          "id": "PROVIDER_NATIVE",
          "label": "Data is primarily provider-native and requires manual normalization."
        },
        {
          "id": "FRAGMENTED",
          "label": "Cost/usage data is fragmented and difficult to reconcile."
