{
  "rulesVersion": "1.0.0",
  "statusAsOf": "2026-10-14",
  "rule": "FinOps IQ v3 engine rules that are not in the F2 registries: rating labels, finding wording, owner roles, severity, need verdict, headline and the legacy questions retired without a v3 question. Every client-visible string here carries claim IDs from the WS-S2 register. Waves, dependencies, targets, offerings and lever links come from registry/capabilities.json and registry/levers.json.",
  "ratingLabels": {
    "not_yet": { "label": "Not yet", "claimIds": ["CLM-FIN-005"] },
    "crawl": { "label": "Crawl", "claimIds": ["CLM-FIN-004", "CLM-FIN-005"] },
    "walk": { "label": "Walk", "claimIds": ["CLM-FIN-004", "CLM-FIN-005"] },
    "run": { "label": "Run", "claimIds": ["CLM-FIN-004", "CLM-FIN-005"] },
    "unknown": { "label": "Unknown", "claimIds": ["CLM-FIN-141"] },
    "not_in_scope": { "label": "Not in scope", "claimIds": ["CLM-FIN-006"] },
    "not_assessed": { "label": "Not assessed", "claimIds": ["CLM-FIN-163"] }
  },
  "workshopOnly": { "label": "Assessed in the workshop", "claimIds": ["CLM-FIN-164"] },
  "ownerRoles": {
    "claimIds": ["CLM-FIN-162"],
    "byCapability": {
      "DATA_INGESTION": "Head of Cloud / CCoE",
      "ALLOCATION": "FinOps lead",
      "REPORTING_ANALYTICS": "FinOps lead",
      "ANOMALY_MANAGEMENT": "Platform / SRE lead",
      "PLANNING_ESTIMATING": "Engineering leads",
      "FORECASTING": "FP&A lead",
      "BUDGETING": "FP&A lead",
      "KPIS_BENCHMARKING": "FinOps lead",
      "UNIT_ECONOMICS": "Product owners",
      "ARCHITECTING_WORKLOAD_PLACEMENT": "Head of Cloud / CCoE",
      "USAGE_OPTIMIZATION": "Engineering leads",
      "RATE_OPTIMIZATION": "FinOps lead",
      "LICENSING_SAAS": "ITAM lead",
      "SUSTAINABILITY": "Sustainability lead",
      "EXECUTIVE_STRATEGY_ALIGNMENT": "CIO",
      "FINOPS_PRACTICE_OPERATIONS": "CIO",
      "GOVERNANCE_POLICY_RISK": "Head of Cloud / CCoE",
      "FINOPS_EDUCATION_ENABLEMENT": "FinOps lead",
      "INVOICING_CHARGEBACK": "CFO",
      "FINOPS_ASSESSMENT": "FinOps lead",
      "AUTOMATION_TOOLS_SERVICES": "FinOps lead",
      "INTERSECTING_DISCIPLINES": "FinOps lead"
    }
  },
  "severity": {
    "assumptionId": "ASM-FIN-005",
    "claimIds": ["CLM-FIN-122"],
    "byGap": { "1": "Medium", "2": "High", "3": "Critical" },
    "foundationUplift": { "capabilities": ["DATA_INGESTION", "ALLOCATION", "FINOPS_PRACTICE_OPERATIONS"], "minTier": 2 },
    "valueUplift": { "pending": "F4", "note": "At least High when a linked lever's expected net run-rate value is 2% or more of in-scope spend (THR-FIN-13). Not applied in F3: there is no value model yet." },
    "lowWhenNoDefaultTarget": true,
    "timeFrames": { "Critical": "0-3 months", "High": "3-6 months", "Medium": "6-12 months", "Low": "12-24 months" }
  },
  "findingText": {
    "claimIds": ["CLM-FIN-005", "CLM-FIN-141", "CLM-FIN-121", "CLM-FIN-122", "CLM-FIN-162"],
    "title": "{capability}: {current}, target {target}",
    "titleUnconfirmed": "{capability}: {current} (not confirmed), target {target}",
    "consequence": "Today: {currentGuidance}",
    "consequenceUnknown": "Not confirmed: the answer was 'Don't know', so this is treated as a gap until it is confirmed.",
    "action": "Move {capability} to {target}: {targetGuidance}",
    "actionUnconfirmed": "Confirm the current practice with evidence, then move {capability} to {target}: {targetGuidance}",
    "evidenceToConfirm": "Evidence behind the answers to {questions}"
  },
  "headline": {
    "claimIds": ["CLM-FIN-121", "CLM-FIN-163", "CLM-FIN-033"],
    "statement": "{atOrAbove} of {inScope} in-scope capabilities with a target are at or above LTM's default target for a Tier {tier} estate",
    "executiveSuffix": " (executive mode: {assessed} capabilities assessed; the rest in the workshop)"
  },
  "needVerdict": {
    "claimIds": ["CLM-FIN-127"],
    "assumptionIds": ["ASM-FIN-030", "ASM-FIN-031", "ASM-FIN-032", "ASM-FIN-033"],
    "cap": 100,
    "modifiers": [
      { "id": "tier_2", "points": 10 },
      { "id": "tier_3", "points": 20 },
      { "id": "expected_value_ge_5pct_of_P", "points": 10, "pending": "F4" },
      { "id": "growth_ge_20pct", "points": 10, "threshold": 20 },
      { "id": "migration_or_ai", "points": 10, "threshold": 0.25 }
    ],
    "bands": [
      { "id": "lightweight", "max": 25, "label": "Lightweight practices sufficient at current scale" },
      { "id": "foundations", "max": 50, "label": "Targeted improvements needed now" },
      { "id": "material", "max": 75, "label": "Material exposure: act this year" },
      { "id": "act_now", "max": 100, "label": "Act now" }
    ],
    "basisLine": "Based on your answers to {questions} questions; LTM's targets for a Tier {tier} estate; not a FinOps Foundation assessment",
    "basisClaimIds": ["CLM-FIN-127", "CLM-FIN-121", "CLM-FIN-033"],
    "confidenceClaimIds": ["CLM-FIN-163"]
  },
  "retiredLegacy": [
    {
      "id": "FIQ.C8",
      "disposition": "moved",
      "to": "Cloud IQ security baseline",
      "reason": "Root MFA and payer-account security is a security control, not a FinOps capability (PLAN.md F1). Owner accepted Q6, subject to the Cloud IQ owner; if declined, it is dropped from FinOps IQ."
    }
  ]
}
