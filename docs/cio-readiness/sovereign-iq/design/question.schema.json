{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ltm:sovereign-iq:v4:question",
  "title": "Sovereign IQ v4 question set and answer set",
  "description": "Merged question set (DESIGN.md section 6). Scope questions set facts and are never scored; maturity questions set exactly one control and always offer Unknown; preference questions are never scored. Also defines the answer-set shape used by archetypes and the request contract. Draft for owner approval (S1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["questionSetVersion", "questions"],
  "properties": {
    "questionSetVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } }
  },
  "$defs": {
    "questionId": {
      "type": "string",
      "pattern": "^(A[1-7]|B[1-6]|C1|D[1-4]|P[1-2]|L[1-3]|R1|T[1-3]|K[1-4]|O[1-3]|V[1-4]|X[1-2]|I[1-2]|G[1-3]|H1|W[1-3])$"
    },
    "stateValue": {
      "description": "Control state an option sets (maturity questions only). 'ignored' leaves the control to the other feeding question (B6 no_ctp_dependency).",
      "anyOf": [
        { "type": "integer", "minimum": 0, "maximum": 3 },
        { "enum": ["unknown", "ignored"] }
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
        "label": { "type": "string" },
        "help": { "type": "string" },
        "state": { "$ref": "#/$defs/stateValue" },
        "group": { "type": "string", "description": "Display group, e.g. 'EU financial (DORA)' in B1." }
      }
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citation", "status"],
      "properties": {
        "ref": { "type": "string", "pattern": "^S[0-9]+$", "description": "DESIGN.md section 15 reference; replaced by claim IDs in S2." },
        "claimId": { "type": "string", "pattern": "^CLM-SOV-[0-9]{3,}$" },
        "citation": { "type": "string" },
        "status": { "$ref": "urn:ltm:sovereign-iq:v4:regime#/$defs/verificationStatus" }
      }
    },
    "field": {
      "description": "A sub-field of a compound question or a column of a matrix question.",
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "label": { "type": "string" },
        "type": { "enum": ["single", "multi", "number_with_currency"] },
        "options": { "type": "array", "items": { "$ref": "#/$defs/option" } },
        "optionsFrom": { "type": "string", "description": "Reuse the options of another question, e.g. 'A1' for zones." },
        "optional": { "type": "boolean" }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "theme", "text", "type", "kind", "mode", "feeds", "basis"],
      "properties": {
        "id": { "$ref": "#/$defs/questionId" },
        "theme": { "enum": ["footprint", "entity", "data", "platform", "requirement", "residency", "transfer", "keys", "operations", "third_party", "exit", "ai", "governance", "preference"] },
        "text": { "type": "string", "description": "CIO wording." },
        "help": { "type": "string" },
        "type": { "enum": ["single", "multi", "matrix", "compound"] },
        "kind": { "enum": ["scope", "maturity", "preference"] },
        "mode": { "enum": ["executive", "workshop", "follow_up"] },
        "trigger": {
          "$ref": "urn:ltm:sovereign-iq:v4:regime#/$defs/condition",
          "description": "Required for follow_up questions and conditional executive questions (T2, I1)."
        },
        "options": { "type": "array", "items": { "$ref": "#/$defs/option" } },
        "optionsFrom": { "type": "string" },
        "matrix": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rowsFrom", "columns"],
          "properties": {
            "rowsFrom": { "type": "string", "description": "e.g. 'A1' (zones) or 'D1' (selected data classes)." },
            "columns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/field" } }
          }
        },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "feeds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "facts": { "type": "array", "items": { "type": "string", "pattern": "^(org|ent|data|plat|prov|xfer|pref)\\.[a-z0-9_]+$" } },
            "controls": { "type": "array", "items": { "$ref": "urn:ltm:sovereign-iq:v4:facts#/$defs/controlId" } }
          }
        },
        "basis": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/basis" } },
        "replaces": { "type": "array", "items": { "type": "string" }, "description": "Old Sovereign IQ (Q1.1…) and Posture IQ (A1…K3) IDs." }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "maturity" } } },
          "then": {
            "required": ["options"],
            "properties": {
              "feeds": { "required": ["controls"], "properties": { "controls": { "minItems": 1, "maxItems": 1 } } },
              "options": { "contains": { "type": "object", "required": ["value"], "properties": { "value": { "const": "unknown" } } } }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "enum": ["scope", "preference"] } } },
          "then": { "properties": { "feeds": { "properties": { "controls": { "maxItems": 0 } } } } }
        },
        {
          "if": { "properties": { "mode": { "const": "follow_up" } } },
          "then": { "required": ["trigger"] }
        },
        {
          "if": { "properties": { "type": { "const": "matrix" } } },
          "then": { "required": ["matrix"] }
        },
        {
          "if": { "properties": { "type": { "const": "compound" } } },
          "then": { "required": ["fields"] }
        }
      ]
    },
    "answerValue": {
      "description": "single: string; multi: array of strings; compound: object of field values; matrix: object keyed by column (A2) or by row (D3, L2).",
      "anyOf": [
        { "type": "string" },
        { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              { "type": "string" },
              { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
              { "$ref": "urn:ltm:sovereign-iq:v4:facts#/$defs/money" },
              {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    { "type": "string" },
                    { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    "answerSet": {
      "description": "Answers keyed by question ID. A question that was not asked (trigger false, or not in the mode) is absent. Absent required questions count as not_answered.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/questionId" },
      "additionalProperties": { "$ref": "#/$defs/answerValue" }
    }
  }
}
