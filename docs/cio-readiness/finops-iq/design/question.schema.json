{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ltm:finops-iq:v3:question",
  "title": "FinOps IQ v3 merged question set, condition language and answer set",
  "description": "Merged question set (DESIGN.md section 7). Scope (SC) and value-base (VB) questions set facts and are never scored; maturity questions (UN, QV, OP, MP) rate exactly one capability and always offer 'unknown'; hypothesis questions (HY) are never scored and never feed value (D4). One set serves both modes; the mode selects questions, never scoring. Draft for owner approval (F1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["questionSetVersion", "questions"],
  "properties": {
    "questionSetVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "executiveSet": {
      "type": "array",
      "description": "Ordered executive question IDs: 18 plus optional HY-01 and HY-07 (DESIGN.md 7.7).",
      "items": { "$ref": "#/$defs/questionId" },
      "maxItems": 20
    },
    "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } },
    "conflictProbes": { "type": "array", "items": { "$ref": "#/$defs/conflictProbe" } }
  },
  "$defs": {
    "questionId": { "type": "string", "pattern": "^(SC|VB|UN|QV|OP|MP|HY)-[0-9]{2}$" },
    "legacyId": {
      "type": "string",
      "description": "Legacy question IDs, prefixed by instrument: FIQ (FinOps IQ KB 2.2.0), FVC (FinOps Value Case KB 1.0.3), CIQ (Cost IQ).",
      "pattern": "^(FIQ\\.(C[1-8]|I[1-9]|O([1-9]|10)|A[1-9]|T[1-8])|FVC\\.(E[1-6]|V[1-5]|P[1-4]|O[1-4]|C[1-5]|L[1-4]|X1)|CIQ\\.FIN-(0[1-9]|1[0-2]))$"
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citation", "status"],
      "properties": {
        "ref": { "$ref": "urn:ltm:finops-iq:v3:facts#/$defs/sourceRef" },
        "claimId": { "$ref": "urn:ltm:finops-iq:v3:facts#/$defs/claimId" },
        "assumptionId": { "$ref": "urn:ltm:finops-iq:v3:facts#/$defs/assumptionId" },
        "citation": { "type": "string" },
        "status": { "$ref": "urn:ltm:finops-iq:v3:facts#/$defs/verificationStatus" }
      }
    },
    "condition": {
      "description": "Rules as data (triggers, scope conditions, tier points). Combinators all/any/not; leaves test a fact path, an answer or a capability rating.",
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["all"], "properties": { "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } } },
        { "type": "object", "additionalProperties": false, "required": ["any"], "properties": { "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } } },
        { "type": "object", "additionalProperties": false, "required": ["not"], "properties": { "not": { "$ref": "#/$defs/condition" } } },
        {
          "type": "object", "additionalProperties": false, "required": ["fact"],
          "properties": {
            "fact": { "type": "string", "pattern": "^(org|footprint|spend|base|evidence|cost)(\\.[A-Za-z0-9_]+)+$" },
            "contains": { "type": "string" },
            "countAtLeast": { "type": "integer", "minimum": 0 },
            "lt": { "type": "number" },
            "gte": { "type": "number" },
            "isUnknown": { "type": "boolean" },
            "in": { "type": "array", "items": { "type": "string" } }
          },
          "minProperties": 2
        },
        {
          "type": "object", "additionalProperties": false, "required": ["answer"],
          "properties": {
            "answer": { "$ref": "#/$defs/questionId" },
            "in": { "type": "array", "items": { "type": "string" } },
            "levelAtMost": { "$ref": "urn:ltm:finops-iq:v3:facts#/$defs/level" },
            "levelAtLeast": { "$ref": "urn:ltm:finops-iq:v3:facts#/$defs/level" },
            "isUnknown": { "type": "boolean" },
            "answered": { "type": "boolean" }
          },
          "minProperties": 2
        }
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "label": { "type": "string" },
        "help": { "type": "string" },
        "level": {
          "description": "Maturity questions only: the level this option sets. Exactly one option per maturity question has level 'unknown' (D5). No 'not applicable' option exists: N/A comes only from scope.",
          "enum": ["not_yet", "crawl", "walk", "run", "unknown"]
        },
        "sets": {
          "description": "Scope and value-base questions: the fact value this option sets (for example a band).",
          "type": "object"
        }
      }
    },
    "field": {
      "description": "Sub-field of a compound or matrix question (for example SC-04 rows, VB-01 shares).",
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "fact"],
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string" },
        "type": { "enum": ["amount", "share", "percent", "select", "multi_select", "date", "text"] },
        "fact": { "type": "string", "description": "Fact path written by this field." },
        "allowBand": { "type": "boolean" },
        "bands": { "type": "array", "items": { "type": "array", "prefixItems": [ { "type": "number" }, { "type": "number" } ], "minItems": 2, "maxItems": 2 } },
        "allowUnknown": { "type": "boolean" },
        "options": { "type": "array", "items": { "$ref": "#/$defs/option" } }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "modes", "text", "answerType", "basis", "legacy"],
      "properties": {
        "id": { "$ref": "#/$defs/questionId" },
        "kind": { "enum": ["scope", "value_base", "maturity", "hypothesis"] },
        "capability": { "$ref": "urn:ltm:finops-iq:v3:facts#/$defs/capabilityId" },
        "role": { "enum": ["core", "scope_conditional", "follow_up"], "description": "Maturity questions: core sets the weakest-link rating; scope_conditional and follow_up can lower it by at most one level (DESIGN.md 3.3)." },
        "modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["executive", "workshop"] } },
        "askWhen": { "$ref": "#/$defs/condition", "description": "Scope condition or answer trigger; absent = always asked in its modes." },
        "coreWhen": { "$ref": "#/$defs/condition", "description": "For questions that are core only in some estates (UN-03: 2+ providers or hybrid)." },
        "text": { "type": "string" },
        "help": { "type": "string" },
        "answerType": { "enum": ["single_select", "multi_select", "compound", "matrix", "percent", "amount", "rank", "allocation_100", "open_text"] },
        "options": { "type": "array", "items": { "$ref": "#/$defs/option" } },
        "multiSelectLevelRule": {
          "description": "For multi-select maturity questions (UN-08): count of selected items mapped to a level (ASM-FIN-021).",
          "type": "array",
          "items": { "type": "object", "additionalProperties": false, "required": ["minCount", "level"], "properties": { "minCount": { "type": "integer", "minimum": 0 }, "level": { "$ref": "urn:ltm:finops-iq:v3:facts#/$defs/level" } } }
        },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "sets": { "type": "array", "items": { "type": "string" }, "description": "Fact paths set (scope and value-base questions)." },
        "derivesFact": {
          "description": "Executive-mode derivations from a maturity answer (ASM-FIN-052: OP-06 to base.nonProdScheduledShare).",
          "type": "object",
          "additionalProperties": false,
          "required": ["fact", "byLevel", "assumptionId"],
          "properties": {
            "fact": { "type": "string" },
            "byLevel": { "type": "object", "additionalProperties": { "type": "number" } },
            "assumptionId": { "$ref": "urn:ltm:finops-iq:v3:facts#/$defs/assumptionId" }
          }
        },
        "useInVerdict": { "type": "boolean", "description": "Hypothesis questions used as urgency signals (HY-03, HY-05)." },
        "basis": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/basis" } },
        "legacy": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "disposition"],
            "properties": {
              "id": { "$ref": "#/$defs/legacyId" },
              "disposition": { "enum": ["kept", "rewritten", "merged", "split", "moved"] },
              "note": { "type": "string" }
            }
          }
        },
        "prefillFrom": { "type": "array", "items": { "type": "string", "pattern": "^CIQ\\.FIN-[0-9]{2}$" }, "description": "Cost IQ suggestions; never scored until confirmed (DESIGN.md 2.3)." }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "maturity" } } },
          "then": {
            "required": ["capability", "role", "options"],
            "properties": { "options": { "contains": { "properties": { "level": { "const": "unknown" } }, "required": ["level"] }, "minContains": 1, "maxContains": 1 } }
          }
        },
        {
          "if": { "properties": { "kind": { "enum": ["scope", "value_base", "hypothesis"] } } },
          "then": { "not": { "required": ["capability"] } }
        }
      ]
    },
    "conflictProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "when", "probe"],
      "properties": {
        "id": { "type": "string", "pattern": "^CP-[0-9]+$" },
        "when": { "$ref": "#/$defs/condition" },
        "probe": { "type": "string" },
        "consultantOnly": { "const": true }
      }
    },
    "answerValue": {
      "description": "An option value, a list of option values, a compound object, a number, or a structured unknown.",
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "array" },
        { "type": "object" }
      ]
    },
    "answerSet": {
      "description": "Request-contract answer set (same for both modes). Missing keys are blanks: excluded and reported as coverage; never scored as better than any answer.",
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "answers"],
      "properties": {
        "mode": { "enum": ["executive", "workshop"] },
        "assessmentDate": { "type": "string", "format": "date" },
        "answers": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/questionId" },
          "additionalProperties": { "$ref": "#/$defs/answerValue" }
        },
        "prefillConfirmed": { "type": "array", "items": { "$ref": "#/$defs/questionId" } },
        "targetOverrides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capability", "level", "reason"],
            "properties": {
              "capability": { "$ref": "urn:ltm:finops-iq:v3:facts#/$defs/capabilityId" },
              "level": { "$ref": "urn:ltm:finops-iq:v3:facts#/$defs/level" },
              "reason": { "type": "string", "minLength": 10 }
            }
          }
        },
        "consultantFacts": { "$ref": "urn:ltm:finops-iq:v3:facts#/properties/consultant" }
      }
    }
  }
}
