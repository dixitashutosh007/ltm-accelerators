  "selection_rules": [
    "Establish business criticality, impact tolerance, required RTO and required RPO first.",
    "Do not infer achievable RTO/RPO from existing technology.",
    "Eliminate candidates that cannot credibly meet the business target unless an explicit risk exception is accepted.",
    "Prefer the lowest-complexity pattern that credibly meets the requirement and threat model.",
    "Increase resilience when cyber compromise, correlated failure, concentration risk or regulation requires it.",
    "Use tiering for portfolios; do not force one recovery pattern across all workloads.",
    "Use dependency-aware recovery for shared platforms, identity, network, data and integration dependencies.",
    "Use cyber recovery patterns when compromise can affect production and ordinary recovery infrastructure.",
    "Use third-party patterns when critical recovery depends on an external provider.",
    "Select vendor implementation only after the vendor-neutral strategy is chosen.",
    "Every recommendation must provide an alternative, rationale, assumptions and testing/evidence plan."
  ],
  "elimination_rules": [
    [
      "required_rto=near-zero",
      "eliminate",
      "DR-01,DR-02"
    ],
    [
      "required_rpo=near-zero",
      "eliminate",
      "DR-01,DR-02"
    ],
    [
      "low_criticality_and_no_regulatory_requirement",
      "prefer",
      "DR-01,DR-06"
    ],
    [
      "critical_service_and_cyber_scope",
      "require_any",
      "DATA-01,DATA-02,CYBER-01,CYBER-02,CYBER-03"
    ],
    [
      "shared_provider_region_or_facility_across_critical_services",
      "require_any",
      "TP-05,TP-03,INF-04,INF-03"
    ],
    [
      "complex_application_dependencies",
      "require_any",
      "DR-07,APP-04,DR-08"
    ],
    [
      "recovery_never_tested",
      "risk",
      "evidence_confidence_low"
    ],
    [
      "backup_only_for_mission_critical_service",
      "risk",
      "strategy_mismatch"
    ]
  ],
