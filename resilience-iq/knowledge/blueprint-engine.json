    ]
  },
  "output_contract": {
    "executive_summary": "3-5 concise paragraphs",
    "scorecard": "domain scores, maturity, confidence and rating",
    "business_requirements": "critical services and recovery objectives",
    "current_state": "capability/evidence/dependency posture",
    "gap_register": "prioritized critical/high/medium/low gaps",
    "target_state": "principles and layered architecture",
    "pattern_decisions": "preferred, alternatives, eliminated and rationale",
    "technology_options": "provider-specific implementation variants",
    "test_plan": "tests, success criteria, evidence and cadence",
    "roadmap": "0-30d, 31-90d, 3-6m, 6-18m",
    "governance": "owners, KPIs/KRIs, review cadence",
    "decision_log": "assumptions, exceptions and unresolved decisions"
  }
}