  "executive_questions": [
    {
      "id": "EX-01",
      "domain": "OPS",
      "taxonomy": "business_service_criticality",
      "text": "Which business services are most critical to the enterprise?",
      "type": "multi_select",
      "options": [
        "Customer-facing services",
        "Revenue-generating services",
        "Regulatory/financial reporting",
        "Workforce-critical services",
        "Supply-chain/operations services",
        "Other"
      ],
      "evidence": [
        "BIA",
        "application inventory"
      ],
      "required": true,
      "ui": {
        "interaction": "multi_select",
        "instruction": "Select every type of service the business cannot operate without.",
        "multi": true
      }
    },
    {
      "id": "EX-02",
      "domain": "OPS",
      "taxonomy": "impact_tolerance",
      "text": "For the most critical service, how long can the business tolerate material disruption before impact becomes unacceptable?",
      "type": "single_select",
      "options": [
        "<15 minutes",
        "15-60 minutes",
        "1-4 hours",
        "4-24 hours",
        ">24 hours",
        "Unknown"
      ],
      "evidence": [
        "BIA"
      ],
      "required": true,
      "ui": {
        "interaction": "slider_choice",
        "instruction": "Move the scale to the closest current business tolerance. No value is assumed: choose a point on the scale, or Unknown."
      }
    },
    {
      "id": "EX-03",
      "domain": "DR",
      "taxonomy": "RTO",
      "text": "What is the required recovery time for the most critical service?",
      "type": "single_select",
      "options": [
        "<15 minutes",
        "15-60 minutes",
        "1-4 hours",
        "4-24 hours",
        ">24 hours",
        "Unknown"
      ],
      "evidence": [
        "RTO/RPO register",
