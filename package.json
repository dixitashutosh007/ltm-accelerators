{
  "name": "ltm-accelerators",
  "version": "1.0.0",
  "description": "Enterprise cloud advisory accelerators with headless scoring engines and role-based access control",
  "private": true,
  "type": "module",
  "scripts": {
    "test:engine": "tsx packages/engine-core/src/test-runner.ts",
    "amplify": "ampx",
    "validate:costiq": "node scripts/validate-cost-iq.cjs",
    "build:costiq-config": "node scripts/generate-cost-iq-runtime-config.cjs",
    "test:resilience": "tsx packages/engine-core/src/accelerators/resilience-iq/evaluate.test.ts && tsx packages/engine-core/src/accelerators/resilience-iq/evidence-lifecycle.test.ts && tsx packages/engine-core/src/accelerators/resilience-iq/assessment-lifecycle.test.ts && tsx packages/engine-core/src/accelerators/resilience-iq/assessment-persistence.test.ts",
    "validate:resilience-bank": "node scripts/validate-resilience-question-bank.cjs",
    "test:resilience-api": "tsx amplify/functions/evaluate-resilience-iq/handler.test.ts",
    "validate:resilience-deployment": "node scripts/validate-resilience-deployment.cjs",
    "validate:resilience-persistence": "node scripts/validate-resilience-assessment-persistence.cjs",
    "test:costiq": "node packages/engine-core/src/accelerators/cost-iq/baseline.test.cjs",
    "test:costiq:hardening": "node packages/engine-core/src/accelerators/cost-iq/assessment-hardening.test.cjs",
    "test:costiq:persistence": "node packages/engine-core/src/accelerators/cost-iq/persistence-contract.test.cjs",
    "test:costiq:persistence:lifecycle": "node packages/engine-core/src/accelerators/cost-iq/persistence-lifecycle.test.cjs",
    "test:costiq:persistence:adapter": "node packages/engine-core/src/accelerators/cost-iq/persistence-adapter.test.cjs",
    "test:costiq:persistence:api": "node packages/engine-core/src/accelerators/cost-iq/persistence-api-contract.test.cjs"
  },
  "dependencies": {
    "@aws-amplify/backend": "^1.14.0",
    "@aws-amplify/backend-cli": "^1.4.0",
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
